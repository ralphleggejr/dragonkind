# Enter credentials locally only. Gmail requires IMAP access and a Google app password.
MAIL_USER=rljr.code@gmail.com
MAIL_PASSWORD=
NOTIFY_TO=rljr.code@gmail.com
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
# Fill these after inspecting the actual site. CSS or Playwright selectors are accepted.
LOGIN_ENTRY_SELECTOR=button[data-reveal-trigger][data-step="4"]
EMAIL_SELECTOR=#next-reader
EMAIL_SUBMIT_SELECTOR=button[aria-label="Send me a code"][type="submit"]
MFA_SELECTOR=#next-code
MFA_AUTO_SUBMIT=true
# Used only when MFA_AUTO_SUBMIT=false; Dragonkind advances automatically.
MFA_SUBMIT_SELECTOR=
AUTH_READY_SELECTOR=a.button[href="/archway"]
# Must identify only the visible story choice buttons/links (not navigation).
CHOICES_SELECTOR=a.button[href="/archway"], button.button[type="submit"]:has-text("Brave Threshing"), button[data-page-next], label[for^="choice-"]
CHOICE_SUBMIT_SELECTOR=button[data-choices-submit][form="choices"]
# Required: a selector visible exclusively on the death screen.
DEATH_SELECTOR=
SIGN_OUT_SELECTOR=
# Restrict to the genuine Dragonkind verification sender address, not the forwarder.
MFA_ORIGINAL_SENDER=hello@dragonkind.com
# Use a pattern matching the site's code format, with exactly one capture group.
MFA_CODE_REGEX=(?i:your confirmation code is)\s+([0-9A-Za-z]{3}-?[0-9A-Za-z]{3})(?![0-9A-Za-z-])
MFA_TIMEOUT_SECONDS=600
# Shadow pauses only the affected account by default. Unexpected failures pause everything.
SHADOW_PAUSE_SCOPE=account
